{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    // ES2022.Error is pulled in on top of ES2020 for the `new Error(msg,
    // { cause })` overload. ESLint's `preserve-caught-error` rule (part of
    // eslint:recommended as of @eslint/js 10) requires a rethrown error to
    // carry the original as its `cause`, and that is the only standard way to
    // attach it. Error cause is a runtime API rather than syntax, so it needs
    // no change to `target`.
    "lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Extra strict checks for runtime safety */
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "exactOptionalPropertyTypes": true,

    /* Path mapping */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Additional type checking */
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src"],
  // `src/test/routeGates.ts` is test infrastructure that reads the route
  // sources off disk. It is excluded for the same reason the `.test.ts` files
  // beside it are: it imports `node:fs`, and the app build has no Node types,
  // so type-checking it here would report the platform rather than the code.
  // Vitest still runs it, and `tsconfig.eslint.json` still lints it.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/__tests__/**", "src/e2e/**", "src/test/routeGates.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
