[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    alembic/versions,
    .pytest_cache,
    venv,
    .venv
ignore =
    # W503: line break before binary operator (conflicts with black)
    W503,
    # E203: whitespace before ':' (conflicts with black)
    E203,
    # E712/E711: comparison to True/False/None — required by SQLAlchemy filters
    E712,
    E711,
    # E402: module-level import not at top — used for circular dependency avoidance
    E402,
    # E501: line too long — enforced by black; remaining are strings/URLs/comments
    E501
per-file-ignores =
    # Allow unused imports in __init__.py
    __init__.py:F401
    # alembic/env.py imports every model for its side effect: importing a model
    # module registers its table on Base.metadata, which is what autogenerate
    # diffs the database against. They are unused by definition — dropping one
    # silently removes a table from autogenerate's view.
    env.py:F401
    # seed_test_users.py keeps a hand-aligned data table (inside a `# fmt: off`
    # block) for readability; ignore the column-alignment spacing codes for it.
    seed_test_users.py:E241,E231
    # PT028 (flake8-pytest-style) fires on any function named test_*. These are
    # FastAPI "test connection" route handlers, not pytest tests, and their
    # Depends() defaults are required by the framework.
    external_training.py:PT028
    integrations.py:PT028
