{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/completion-gate.sh",
            "timeout": 600,
            "statusMessage": "Running the completion gate..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run lint:backend)",
      "Bash(npm run lint:backend:*)",
      "Bash(npm run lint:frontend)",
      "Bash(npm run lint:frontend:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run validate)",
      "Bash(npm run validate:*)",
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm run test:backend)",
      "Bash(npm run test:backend:*)",
      "Bash(npm run test:frontend)",
      "Bash(npm run test:frontend:*)",
      "Bash(npx tsc)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier --check)",
      "Bash(npx prettier --check:*)",
      "Bash(npx vitest run)",
      "Bash(npx vitest run:*)",
      "Bash(python3 -m flake8)",
      "Bash(python3 -m flake8:*)",
      "Bash(python -m flake8)",
      "Bash(python -m flake8:*)",
      "Bash(python3 -m black --check)",
      "Bash(python3 -m black --check:*)",
      "Bash(python -m black --check)",
      "Bash(python -m black --check:*)",
      "Bash(python3 -m isort --check-only)",
      "Bash(python3 -m isort --check-only:*)",
      "Bash(python -m isort --check-only)",
      "Bash(python -m isort --check-only:*)",
      "Bash(python3 -m mypy)",
      "Bash(python3 -m mypy:*)",
      "Bash(python -m mypy)",
      "Bash(python -m mypy:*)",
      "Bash(python3 -m pytest)",
      "Bash(python3 -m pytest:*)",
      "Bash(python -m pytest)",
      "Bash(python -m pytest:*)",
      "Bash(pytest)",
      "Bash(pytest:*)",
      "Bash(python3 -m alembic current)",
      "Bash(python3 -m alembic current:*)",
      "Bash(python3 -m alembic heads)",
      "Bash(python3 -m alembic heads:*)",
      "Bash(python3 -m alembic history)",
      "Bash(python3 -m alembic history:*)",
      "Bash(python3 -m alembic check)",
      "Bash(python3 -m alembic check:*)",
      "Bash(python3 scripts/check_docs_links.py)",
      "Bash(python3 scripts/check_docs_links.py:*)",
      "Bash(python3 scripts/check_ci_gate.py)",
      "Bash(python3 scripts/check_ci_gate.py:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git remote -v:*)",
      "Bash(git fetch)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files)",
      "Bash(git ls-files:*)",
      "Bash(git blame)",
      "Bash(git blame:*)",
      "Bash(git stash list)",
      "Bash(git stash list:*)"
    ]
  }
}
