# git feeds one line per pushed ref: <local ref> <local sha> <remote ref> <remote sha>
status=0
while read -r _local_ref local_sha _rest; do
    # An all-zero sha is a branch deletion; there is nothing to check.
    case $local_sha in
        *[!0]*) ;;
        *) continue ;;
    esac
    sh scripts/check-migration-heads.sh "$local_sha" || status=1
done
exit $status
