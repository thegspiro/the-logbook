# Copy to docs-site/.env (git ignores it) and fill in. Read by
# docs-site/docker-compose.yml.

# Token of the tunnel that serves ONLY the docs site. In Cloudflare Zero Trust:
# Networks > Tunnels > Create a tunnel > Cloudflared, then copy the token from
# the "docker run" command it shows (the long string after --token).
DOCS_TUNNEL_TOKEN=

# Image tag. "latest" follows every merge to main; a "sha-<commit>" tag from
# ghcr.io/thegspiro/the-logbook-docs holds the site at one reviewed build.
DOCS_IMAGE_TAG=latest
